# Optional root defaults for Docker Compose.
# Copy this file to .env if you want to override the default local Postgres values.

POSTGRES_USER=reuse
POSTGRES_PASSWORD=reuse
POSTGRES_DB=reuse
POSTGRES_TEST_USER=reuse_test
POSTGRES_TEST_PASSWORD=reuse_test
POSTGRES_TEST_DB=reuse_test

# Backend and frontend settings live in the app-specific .env.example files.
# - backend/.env.example
# - frontend/.env.example
