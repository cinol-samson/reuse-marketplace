# Backend environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://reuse:reuse@localhost:5432/reuse
TEST_DATABASE_URL=postgresql://reuse_test:reuse_test@localhost:5433/reuse_test

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRE_DAYS=7

# ── Admin ─────────────────────────────────────────────────
# ADMIN_EMAIL=admin@example.com

# ── Cloudinary ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── AI (Anthropic) ────────────────────────────────────────
# AI_MODEL=claude-3-5-haiku-latest
# ANTHROPIC_API_KEY=your-key

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── Listing rules (all optional – defaults shown) ─────────
# LISTING_TTL_DAYS=60
# EXPIRY_REMINDER_DAYS=7
# RESERVATION_DAYS_PICKUP=3
# RESERVATION_DAYS_SHIPPING=7
# RESERVATION_REMINDER_HOURS=24
# MAX_EXTENSIONS=2
# REQUEST_PENDING_DAYS=5
# CHAT_RETENTION_DAYS=60
# MAX_MESSAGE_CHARS=2000
# NEARBY_DEFAULT_RADIUS_KM=5
# COORD_DECIMALS=3
# MAX_PHOTOS_ITEM=5
# MAX_PHOTOS_POST=3
# MAX_MENTIONS_PER_ITEM=3
# RECOMMEND_DAILY_LIMIT=10
# AI_DAILY_LIMIT=10
# REPORT_AUTOHIDE_THRESHOLD=3
# NEW_ACCOUNT_DAYS=7
# NEW_ACCOUNT_DAILY_LISTINGS=5
# MAX_PAIR_EXCHANGES_PER_30_DAYS=2
# LAUNCH_BBOX=
# PROHIBITED_KEYWORDS=firearm,ammunition,explosive,prescription,narcotic,stolen
